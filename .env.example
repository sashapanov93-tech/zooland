# Copy this file to .env. Do not commit .env.
ZOOLAND_ENV=production
ZOOLAND_DEBUG=0
ZOOLAND_HOST=127.0.0.1
ZOOLAND_PORT=5000
# Оставьте пустым для PROJECT_ROOT/zooland.db; в тестах можно указать отдельный абсолютный путь.
ZOOLAND_DB_PATH=
ZOOLAND_PUBLIC_BASE_URL=https://example.com
ZOOLAND_TRUSTED_HOSTS=example.com,www.example.com
ZOOLAND_SECRET_KEY=generate_a_unique_96_character_hex_secret
# В production защита fail-closed: без работающего clamd изображения не принимаются.
ZOOLAND_REQUIRE_ANTIVIRUS=1
ZOOLAND_CLAMAV_HOST=127.0.0.1
ZOOLAND_CLAMAV_PORT=3310

ZOOLAND_SMTP_HOST=smtp.gmail.com
ZOOLAND_SMTP_PORT=587
ZOOLAND_SMTP_TLS=1
ZOOLAND_SMTP_USERNAME=your_mailbox@example.com
ZOOLAND_SMTP_PASSWORD=your_gmail_app_password
ZOOLAND_SMTP_FROM=your_mailbox@example.com
ZOOLAND_SUPPORT_EMAIL=your_mailbox@example.com
