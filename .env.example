# Copy this file to .env. Do not commit .env.
ZOOLAND_ENV=production
ZOOLAND_DEBUG=0
ZOOLAND_HOST=127.0.0.1
ZOOLAND_PORT=5000
# Production-данные держите вне checkout и выдайте доступ только service user.
ZOOLAND_DB_PATH=/var/lib/zooland/zooland.db
ZOOLAND_UPLOAD_FOLDER=/var/lib/zooland/uploads
ZOOLAND_PUBLIC_BASE_URL=https://example.com
ZOOLAND_TRUSTED_HOSTS=example.com,www.example.com
# Ровно один доверенный Nginx перед Gunicorn. Без reverse proxy поставьте 0.
ZOOLAND_TRUST_PROXY_HOPS=1
# Оставлено пустым намеренно: production не запустится с шаблонным ключом.
# Создание: openssl rand -hex 48
ZOOLAND_SECRET_KEY=
# В production защита fail-closed: без работающего clamd изображения не принимаются.
ZOOLAND_REQUIRE_ANTIVIRUS=1
ZOOLAND_CLAMAV_HOST=127.0.0.1
ZOOLAND_CLAMAV_PORT=3310

ZOOLAND_SMTP_HOST=
ZOOLAND_SMTP_PORT=587
ZOOLAND_SMTP_TLS=1
ZOOLAND_SMTP_USERNAME=
ZOOLAND_SMTP_PASSWORD=
ZOOLAND_SMTP_FROM=
ZOOLAND_SUPPORT_EMAIL=

# Реальные реквизиты оператора персональных данных. Не используйте вымышленные.
ZOOLAND_OPERATOR_NAME=
ZOOLAND_OPERATOR_ADDRESS=
ZOOLAND_PRIVACY_EMAIL=
