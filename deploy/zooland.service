[Unit]
Description=ZooLand Gunicorn web application
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/var/lib/zooland
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=zooland
Group=zooland
WorkingDirectory=/opt/zooland/current
EnvironmentFile=/etc/zooland/zooland.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
StateDirectory=zooland
StateDirectoryMode=0710

ExecStartPre=/usr/bin/test -r /var/lib/zooland/zooland.db
ExecStartPre=/usr/bin/test -w /var/lib/zooland/uploads
ExecStart=/opt/zooland/venv/bin/python -m gunicorn --workers 3 --bind 127.0.0.1:5000 --forwarded-allow-ips 127.0.0.1 --timeout 30 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --access-logformat "%%(t)s %%(m)s %%(s)s %%(L)s %%(b)s" --error-logfile - --capture-output wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zooland

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/zooland
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
