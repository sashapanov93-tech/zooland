[Unit]
Description=ZooLand saved-search notification queue worker
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/var/lib/zooland

[Service]
Type=oneshot
User=zooland
Group=zooland
WorkingDirectory=/opt/zooland/current
EnvironmentFile=/etc/zooland/zooland.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
StateDirectory=zooland
StateDirectoryMode=0710

ExecStartPre=/usr/bin/test -r /var/lib/zooland/zooland.db
ExecStartPre=/usr/bin/test -w /var/lib/zooland/zooland.db
ExecStart=/opt/zooland/venv/bin/python -m flask --app app process-notifications --max-jobs 10
TimeoutStartSec=15min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zooland-notifications

Nice=10
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/zooland
